{
  "name": "designhub-worker",
  "version": "0.1.4",
  "private": true,
  "description": "DesignHub Factory local image generation worker",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-renderer.mjs",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.designhub.factory.worker",
    "productName": "DesignHub Worker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DesignHub-Worker-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
